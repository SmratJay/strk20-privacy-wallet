# Environment variables — never commit this file
# Copy to .env.local and fill in your values

# Alchemy Starknet Mainnet RPC key
# Get yours at https://www.alchemy.com
ALCHEMY_STARKNET_KEY=your_alchemy_key_here

# Derived RPC URL — used by the app
NEXT_PUBLIC_STARKNET_RPC=https://starknet-mainnet.g.alchemy.com/v2/${ALCHEMY_STARKNET_KEY}

# STRK20 Pool address (Starknet Mainnet)
NEXT_PUBLIC_STRK20_POOL=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a

# STRK20 Pool address (Starknet Sepolia)
NEXT_PUBLIC_STRK20_SEPOLIA_POOL=0x0254a6b2997ef52e9f830ce1f543f6b29768295e8d17e2267d672c552cfe0d91

# Official Circle USDC on Starknet Sepolia (collateral for shield/unshield)
NEXT_PUBLIC_USDC_SEPOLIA=0x0512feac6339ff7889822cb5aa2a86c848e9d392bb0e3e237c008674feed8343

# STRK20 operator infrastructure (see src/services/strk20SdkService.ts)
# Proving service (Stwo transaction prover) — must match PRIVACY-0.14.x tag used by the pool
NEXT_PUBLIC_STRK20_PROVER_URL=https://your-prover.example.com
# Discovery service (note/channel indexer)
NEXT_PUBLIC_STRK20_DISCOVERY_URL=https://your-discovery.example.com

# ── AVNU swaps (public + STRK20 private) ─────────────────────────────────────────
# Private swaps are gas-sponsored by AVNU's paymaster. This key authenticates the
# paymaster and is held SERVER-ONLY (see src/app/api/avnu/paymaster/route.ts). NEVER
# prefix with NEXT_PUBLIC_. Get one from https://portal.avnu.fi
AVNU_PAYMASTER_API_KEY=

# ── Hamster AI (private AI treasury agent) ───────────────────────────────────────
# OpenAI-compatible chat-completions endpoint (OpenAI, OpenRouter, Together, Groq, local…).
# SERVER-ONLY — NEVER prefix with NEXT_PUBLIC_. The AI only proposes; the deterministic
# policy engine + user confirmation gate every execution (see src/ai/*).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Server-authoritative execution allowlists (canonical 0x addresses, comma-separated).
# Execution destinations are ONLY the user's primary + Shadow Account addresses plus these.
# An empty destination allowlist DENIES all execution.
AI_ALLOWED_ASSETS=
AI_ALLOWED_DESTINATIONS=

# Privy (embedded Starknet wallets). Get App ID / App Secret from the Privy dashboard.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
NEXT_PUBLIC_PRIVY_APP_ID=
# Ready (Argent v0.4.0) account class hash on Starknet Sepolia (verified on-chain). The
# on-chain account address is DERIVED from the public key + this class hash — it is NOT
# Privy's wallet.address (see docs/PRIVY_STRK20_COMPATIBILITY_AUDIT.md).
NEXT_PUBLIC_READY_CLASSHASH=0x036078334509b514626504edc9fb252328d1a240e4e948bef8d0c08dff45927f

# Chain
NEXT_PUBLIC_CHAIN_ID=SN_MAIN

# ── ORRANGE LAUNCHPAD V2 (memecoin launchpad, Starknet Sepolia only) ───────────────
# Sepolia TokenFactory V2 + GraduationRouter V2 addresses, written by
# scripts/launch_deploy.mjs. With these set, /explore reads the live factory and /launch
# deploys real coins. There is no seeded demo registry in V2 — the factory is the only
# source of truth. NEXT_PUBLIC_UMBRA_TREASURY is the protocol fee treasury (defaults to
# the deployer if unset).
NEXT_PUBLIC_UMBRA_SEPOLIA_FACTORY=
NEXT_PUBLIC_UMBRA_ROUTER=
NEXT_PUBLIC_UMBRA_TREASURY=
NEXT_PUBLIC_UMBRA_HAMSTR_TOKEN=
NEXT_PUBLIC_UMBRA_HAMSTR_CURVE=
NEXT_PUBLIC_UMBRA_HAMSTR_EXECUTOR=

# ── Extended Exchange (production perps, STARKNET MAINNET) ────────────────────
# MAINNET is the default and primary network. Public market data needs no
# credentials; account reads and order placement need the server-side credentials
# below (or a natively onboarded wallet session).
#
# PUBLIC configuration (safe to expose to the browser). Defaults already match
# mainnet — override only to point at another network.
NEXT_PUBLIC_EXTENDED_API_BASE_URL=https://api.starknet.extended.exchange/api/v1
NEXT_PUBLIC_EXTENDED_ONBOARDING_URL=https://api.starknet.extended.exchange
NEXT_PUBLIC_EXTENDED_SIGNING_DOMAIN=extended.exchange
NEXT_PUBLIC_EXTENDED_AUTH_HOST=extended.exchange
NEXT_PUBLIC_EXTENDED_STREAM_URL=wss://api.starknet.extended.exchange/stream.extended.exchange/v1
NEXT_PUBLIC_EXTENDED_DEPOSIT_CONTRACT=0x062da0780fae50d68cecaa5a051606dc21217ba290969b302db4dd99d2e9b470
NEXT_PUBLIC_EXTENDED_USDC_TOKEN=0x053c91253bc9682c04929ca02ed00b3e423f6710d2ee7e0d5ebb06f3ecf368a8

# SERVER-ONLY credentials (NEVER prefix with NEXT_PUBLIC_ — they must never reach the
# client bundle). Obtained from the Extended mainnet API-management page:
#   https://app.extended.exchange/api-management
# The Stark private key signs orders/withdrawals server-side and must never be exposed
# to the browser.
EXTENDED_API_KEY=
EXTENDED_STARK_PRIVATE_KEY=
EXTENDED_STARK_PUBLIC_KEY=
EXTENDED_VAULT_ID=
EXTENDED_ACCOUNT_ID=
# Optional Starknet address that receives withdrawals in env-credential mode.
# With an onboarded wallet session this is auto-filled from the connected wallet.
EXTENDED_WITHDRAWAL_RECIPIENT=

# ── Legacy PEL perps (hidden experiment) ──────────────────────────────────────────
# The PEL engine moved to perps-experiment/ and is NOT part of the production app.
# Its deployment env vars (NEXT_PUBLIC_PEL_CORE_SEPOLIA, the five verifiers, the LP
# vault triplet, KEEPER_*) are documented in perps-experiment/ and no longer required
# to run the Dapp.

