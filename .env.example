# Environment variables — never commit this file
# Copy to .env.local and fill in your values

# Alchemy Starknet Mainnet RPC key
# Get yours at https://www.alchemy.com
ALCHEMY_STARKNET_KEY=your_alchemy_key_here

# Derived RPC URL — used by the app
NEXT_PUBLIC_STARKNET_RPC=https://starknet-mainnet.g.alchemy.com/v2/${ALCHEMY_STARKNET_KEY}

# STRK20 Pool address (Starknet Mainnet)
NEXT_PUBLIC_STRK20_POOL=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a

# STRK20 Pool address (Starknet Sepolia)
NEXT_PUBLIC_STRK20_SEPOLIA_POOL=0x0254a6b2997ef52e9f830ce1f543f6b29768295e8d17e2267d672c552cfe0d91

# Official Circle USDC on Starknet Sepolia (collateral for shield/unshield)
NEXT_PUBLIC_USDC_SEPOLIA=0x0512feac6339ff7889822cb5aa2a86c848e9d392bb0e3e237c008674feed8343

# STRK20 operator infrastructure (see src/services/strk20SdkService.ts)
# Proving service (Stwo transaction prover) — must match PRIVACY-0.14.x tag used by the pool
NEXT_PUBLIC_STRK20_PROVER_URL=https://your-prover.example.com
# Discovery service (note/channel indexer)
NEXT_PUBLIC_STRK20_DISCOVERY_URL=https://your-discovery.example.com

# Chain
NEXT_PUBLIC_CHAIN_ID=SN_MAIN
