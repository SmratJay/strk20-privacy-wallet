# STRK20 operator infrastructure environment (copy to .env and fill).

# Starknet Sepolia node — HTTP + WebSocket. Use the same chain for both.
RPC_URL=https://api.cartridge.gg/x/starknet/sepolia
WS_URL=ws://pathfinder:9545

# Required only if running the bundled Pathfinder node (L1 RPC for L1-L2 sync).
ETHEREUM_API_URL=

# Transaction prover (external StarkWare service). Set the URL the app will use:
#   NEXT_PUBLIC_STRK20_PROVER_URL=https://your-prover.example.com
# The discovery service below serves on :8080 and the app uses:
#   NEXT_PUBLIC_STRK20_DISCOVERY_URL=http://localhost:8080

RUST_LOG=info